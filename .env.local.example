# .env.local — Supabase keys (get these from Supabase Dashboard → Settings → API)
# =============================================================================

# Required
NEXT_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY

# Optional — only needed if you use server-side admin operations (service role key)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# =============================================================================
# TO SET UP:
# 1. Create a Supabase project at https://supabase.com
# 2. Run the SQL in supabase/schema.sql in the SQL Editor
# 3. Copy Project URL + anon public key from Settings → API
# 4. Paste them above
# 5. Restart the dev server
# =============================================================================